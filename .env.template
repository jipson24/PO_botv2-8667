# Environment
NODE_ENV=development
WEBSITE_URL=http://localhost:3000
APPLICATION_ID=

# Better Auth - Configuration
BETTER_AUTH_SECRET=

# Database (Turso)
DATABASE_URL=
DATABASE_AUTH_TOKEN=

# Gateway Configuration
AI_GATEWAY_BASE_URL=
AI_GATEWAY_API_KEY=

# Payments and tracking
AUTUMN_SECRET_KEY=

# ─────────────────────────────────────────────────────────────
# Pocket Signal Bot
# ─────────────────────────────────────────────────────────────

# Telegram-бот: токен от @BotFather. Без него рассылка выключена,
# движок продолжит писать сигналы только в базу и дашборд.
TELEGRAM_BOT_TOKEN=

# Необязательно: чат, который подписывается автоматически при старте.
# Работает только если бот уже может в него писать (в группу его надо
# добавить руками). Обычные подписки делаются командой /start.
TELEGRAM_DEFAULT_CHAT_ID=

# Сессия Pocket Option — источник свечей по OTC-парам.
# Берётся из браузера: DevTools → Network → WS → кадр 42["auth",{...}].
# Целиком, вместе с 42[...] и в одинарных кавычках.
POCKET_OPTION_SSID=

# 0 — реальный счёт (api-eu.po.market), 1 — демо (demo-api-eu.po.market).
# Должно совпадать с isDemo внутри строки сессии.
POCKET_OPTION_DEMO=0

# UID из той же строки сессии.
POCKET_OPTION_UID=

# User-Agent браузера, в котором выписана сессия. PO сверяет его при
# авторизации — с чужим UA фид молча не отдаёт котировки.
POCKET_OPTION_UA=

# Отладка фида: печатает размер каждой страницы истории. Только для диагностики.
PO_FEED_DEBUG=0
